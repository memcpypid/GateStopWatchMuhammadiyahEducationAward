# Gate Timer - Backend Environment Variables Example
# Copy this file to .env in the backend folder and customize

# ============================================
# Communication Method Selection
# ============================================
# Options: websocket, http, udp
COMM_MODE=http

# ============================================
# Server Ports
# ============================================
PORT=3000
UDP_PORT=9090

# ============================================
# Example Configurations
# ============================================

# --- WebSocket Server ---
# COMM_MODE=websocket
# PORT=3000

# --- HTTP REST API Server ---
# COMM_MODE=http
# PORT=3000

# --- UDP Server ---
# COMM_MODE=udp
# UDP_PORT=9090
# PORT=3000 (still used for health checks)

# ============================================
# Production Configuration
# ============================================
# For production, you may want:
# - Different ports
# - CORS restrictions
# - TLS/SSL configuration
# - Rate limiting
# - Authentication tokens
# (These would require code modifications)
