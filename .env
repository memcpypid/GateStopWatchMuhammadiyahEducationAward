# Gate Timer Frontend Configuration (Vue CLI)
# Note: Vue CLI uses VUE_APP_ prefix for environment variables

# Frontend port (Vue dev server)
VUE_APP_PORT=8080

# Select communication method: websocket, http, or udp
VUE_APP_COMM_MODE=websocket

# Backend URLs (used by frontend)
VUE_APP_BACKEND_URL=http://172.16.50.206:3000
VUE_APP_WS_URL=ws://172.16.50.206:3000

# Ports (reference for configuration)
VUE_APP_HTTP_PORT=3000
VUE_APP_WS_PORT=3000
VUE_APP_UDP_PORT=9090

# ============================================
# Example Configurations for Different Scenarios
# ============================================

# --- WebSocket Mode (Default) ---
# VUE_APP_COMM_MODE=websocket
# VUE_APP_BACKEND_URL=http://172.16.50.206:8080
# VUE_APP_WS_URL=ws://172.16.50.206:8080

# --- HTTP POST Mode ---
# VUE_APP_COMM_MODE=http
# VUE_APP_BACKEND_URL=http://172.16.50.206:8080

# --- UDP Mode (Lightweight) ---
# VUE_APP_COMM_MODE=udp
# VUE_APP_BACKEND_URL=http://172.16.50.206:8080 # Still used for status checks

# --- Production Examples ---
# Replace 'example.com' with your actual domain/IP

# WebSocket (Production)
# VUE_APP_COMM_MODE=websocket
# VUE_APP_BACKEND_URL=https://api.example.com
# VUE_APP_WS_URL=wss://api.example.com

# HTTP (Production)
# VUE_APP_COMM_MODE=http
# VUE_APP_BACKEND_URL=https://api.example.com

# --- Local Network (Different IP) ---
# VUE_APP_COMM_MODE=websocket
# VUE_APP_BACKEND_URL=http://192.168.1.100:8080
# VUE_APP_WS_URL=ws://192.168.1.100:8080


# https://www.builder.io/c/docs/using-your-api-key
PUBLIC_BUILDER_KEY=2974d2684daf4527b9e390781e43aa67

